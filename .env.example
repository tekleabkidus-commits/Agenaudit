APP_NAME="Agent Audit Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Addis_Ababa
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agent_audit
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=private
EVIDENCE_DISK=private

DEVICE_COOKIE_NAME=agent_audit_device
DEVICE_COOKIE_YEARS=25
DEVICE_COOKIE_BROWSER_DAYS=395
DEVICE_COOKIE_SECURE=false

AI_ENABLED=false
AI_DRIVER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=gpt-5.6
# Alternative only for explicitly approved non-sensitive evidence.
# Google free tier may use submitted content to improve its products.
# Do NOT set GEMINI_ALLOW_SENSITIVE_EVIDENCE=true with real bank receipts
# without evaluating the provider's data-use terms and customer consent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOW_SENSITIVE_EVIDENCE=false
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Cloudflare Workers AI: free allocation available; review model license.
# Unlike Google's unpaid Gemini, Cloudflare says Workers AI customer
# content is not used to train models without consent.
# Alternative for real financial proof images.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
AI_TIMEOUT_SECONDS=45
AI_MIN_QUALITY_SCORE=0.80
AI_MIN_CRITICAL_CONFIDENCE=0.75
AI_AUTO_ACCEPT_CONFIDENCE=0.90

CHECK_ET_ENABLED=false
CHECK_ET_API_KEY=
CHECK_ET_BASE_URL=https://api.check.et
CHECK_ET_TIMEOUT_SECONDS=8
CHECK_ET_RETRIES=1
CHECK_ET_OUTAGE_MODE=review
CHECK_ET_FAILURE_MODE=review

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!123
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=ChangeMe!123

MAX_AGENT_IMPORT_ROWS=50000

# One-time Laravel Cloud admin bootstrap. Remove password after first admin is created.
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
